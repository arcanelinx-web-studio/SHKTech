SITE_URL=https://shktech.pages.dev

# SHK lead desk / Cloudflare Pages Functions
# Bind a Cloudflare D1 database to this project as DB.
ADMIN_USER=shk
ADMIN_PASSWORD=CHANGE_IN_CLOUDFLARE_SECRET
ADMIN_SESSION_SECRET=CHANGE_TO_LONG_RANDOM_SECRET

# Transactional enquiry email / catalogue delivery
RESEND_API_KEY=CONFIGURE_AS_SECRET
ENQUIRY_FROM_EMAIL=SHK Tech Services <enquiries@your-verified-domain.example>
SHK_ALERT_EMAIL=shktechservices@gmail.com

# Optional WhatsApp Business Platform template delivery.
# Template body variables are expected in this order:
# {{1}} customer name, {{2}} enquiry reference, {{3}} catalogue URL.
WHATSAPP_TOKEN=CONFIGURE_AS_SECRET
WHATSAPP_PHONE_NUMBER_ID=CONFIGURE_AS_SECRET
WHATSAPP_TEMPLATE_NAME=shk_enquiry_catalogue
WHATSAPP_TEMPLATE_LANGUAGE=en
