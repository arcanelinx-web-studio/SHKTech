---
import { products } from '../../data/products';
import { site } from '../../config/site';
import WhatsAppCTA from '../global/WhatsAppCTA.astro';
import { ArrowUpRight, Paperclip, ChevronDown } from '@lucide/astro';
---

<section class="section requirement" id="requirement">
  <div class="container requirement-grid">
    <div class="requirement-intro">
      <p class="eyebrow">07 — TALK TO AN ENGINEER</p>
      <h2>Send us the part, the drawing or the <span class="blue">problem.</span></h2>
      <p>
        Attach a drawing, a photo of the machine or a PDF. Share the requirement and continue the
        conversation with SHK on WhatsApp.
      </p>
      <dl class="contact-details">
        <dt class="mono">PHONE</dt>
        <dd><a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a></dd>
        <dt class="mono">EMAIL</dt>
        <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
        <dt class="mono">VISIT</dt>
        <dd>{site.contact.address}</dd>
      </dl>
      <WhatsAppCTA />
    </div>

    <form id="requirement-form" class="requirement-form">
      <fieldset>
        <legend>What do you need?</legend>
        <div class="type-options">
          {[
            'Product',
            'Technical consultation',
            'Calibration',
            'Reconditioning',
            'Retrofit',
            'Spare part',
            'Quotation',
          ].map((type, i) => (
            <label>
              <input type="radio" name="type" value={type} checked={i === 0} />
              <span>{type}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="form-pair">
        <label>
          Name <span aria-hidden="true">*</span>
          <input name="name" autocomplete="name" required maxlength="100" />
        </label>
        <label>
          Company
          <input name="company" autocomplete="organization" maxlength="140" />
        </label>
      </div>

      <div class="form-pair">
        <label>
          Phone / WhatsApp
          <input name="phone" type="tel" autocomplete="tel" maxlength="30" aria-describedby="contact-hint" />
        </label>
        <label>
          Email
          <input name="email" type="email" autocomplete="email" maxlength="150" aria-describedby="contact-hint" />
        </label>
      </div>
      <p id="contact-hint" class="field-hint">Provide a phone number or email so SHK can contact you.</p>

      <label>
        Machine, part or requirement <span aria-hidden="true">*</span>
        <textarea
          name="details"
          rows="3"
          required
          maxlength="3000"
          placeholder="Tell us what you are trying to achieve, what is going wrong, or what product you need."
        ></textarea>
      </label>

      <div class="requirement-utility-row">
        <label class="attachment">
          <span><Paperclip size={17} /> Drawing, photo or PDF</span>
          <input
            id="attachment"
            type="file"
            multiple
            accept=".pdf,.jpg,.jpeg,.png,.webp,.dwg,.dxf,.step,.stp"
            aria-describedby="attachment-hint"
          />
        </label>
        <div class="selected-items compact-selected">
          <span class="mono">ENQUIRY LIST</span>
          <p data-selected-summary>No items selected.</p>
          <a href="/enquiry/">Review ↗</a>
        </div>
      </div>

      <p id="attachment-hint" class="field-hint">
        Files stay on your device. WhatsApp opens with the requirement text; attach the selected file there before sending.
      </p>
      <p id="file-status" class="field-hint" aria-live="polite"></p>

      <details class="requirement-advanced">
        <summary>
          <span>More machine details <small>optional</small></span>
          <ChevronDown size={17} aria-hidden="true" />
        </summary>
        <div class="requirement-advanced-body">
          <div class="form-pair">
            <label>
              Machine type
              <select name="machineType">
                <option value="">Select if known</option>
                {[
                  'Vertical Machining Centre',
                  'Horizontal Machining Centre',
                  'Turning Centre',
                  'Grinding Machine',
                  'Other',
                ].map((v) => <option>{v}</option>)}
              </select>
            </label>
            <label>
              Machine make / model
              <input name="machineModel" maxlength="150" />
            </label>
          </div>
          <div class="form-pair">
            <label>
              Product / category
              <select name="category">
                <option value="">Help me identify the right solution</option>
                {products.map((p) => <option value={p.title}>{p.title}</option>)}
              </select>
            </label>
            <label>
              Preferred contact
              <select name="preferred">
                <option>WhatsApp</option>
                <option>Phone</option>
                <option>Email</option>
              </select>
            </label>
          </div>
        </div>
      </details>

      <p id="form-error" class="form-error" role="alert" tabindex="-1"></p>
      <div class="requirement-submit-row">
        <button class="button button-primary form-submit" type="submit" disabled>
          Send requirement <ArrowUpRight size={18} />
        </button>
        <span class="field-hint">Opens WhatsApp for review. Nothing is sent automatically.</span>
      </div>

      <div id="whatsapp-result" hidden>
        <p id="handoff-status">Your requirement is ready. Review it in WhatsApp, attach any files, then send.</p>
        <a id="whatsapp-open" class="button button-primary" href="#">Open WhatsApp ↗</a>
        <button class="button button-secondary" id="copy-message" type="button">Copy requirement</button>
        <p id="copy-status" role="status"></p>
        <details>
          <summary>Review message</summary>
          <pre id="message-preview"></pre>
        </details>
      </div>

      <noscript>
        <p>
          Please enable JavaScript to generate a structured enquiry, or
          <a href={`https://wa.me/${site.contact.whatsapp}`}>contact SHK on WhatsApp</a>.
        </p>
      </noscript>
    </form>
  </div>
</section>

<script>
  import { buildMessage, whatsappUrl, createReference } from '../../utils/whatsapp';
  import { getItems } from '../../stores/enquiry';
  const form = document.querySelector<HTMLFormElement>('#requirement-form')!;
  form.querySelector<HTMLButtonElement>('.form-submit')!.disabled = false;
  const attachment = document.querySelector<HTMLInputElement>('#attachment')!;
  let message = '';
  let reference = '';
  attachment.addEventListener('change', () => {
    document.getElementById('file-status')!.textContent = Array.from(attachment.files || [])
      .map((f) => f.name)
      .join(' · ');
  });
  function context() {
    const params = new URLSearchParams(location.hash.split('?')[1] || location.search);
    const category = params.get('category');
    const type = params.get('type');
    const details = params.get('details');
    const industry = params.get('industry');
    if (category) (form.elements.namedItem('category') as HTMLSelectElement).value = category;
    if (type) {
      const radio = Array.from(form.querySelectorAll<HTMLInputElement>('[name="type"]')).find(
        (r) => r.value === type,
      );
      if (radio) radio.checked = true;
    }
    if (details || industry)
      (form.elements.namedItem('details') as HTMLTextAreaElement).value =
        details || `Manufacturing environment: ${industry}\n`;
  }
  context();
  window.addEventListener('hashchange', context);
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) || '').trim();
    const error = document.getElementById('form-error')!;
    error.textContent = '';
    if (!value('name') || !value('details')) {
      error.textContent = 'Enter your name and a brief description of the requirement.';
      error.focus();
      return;
    }
    const phone = value('phone'),
      email = value('email');
    if (!phone && !email) {
      error.textContent = 'Enter a phone number or email address so SHK can contact you.';
      error.focus();
      return;
    }
    if (phone && phone.replace(/\D/g, '').length < 7) {
      error.textContent = 'Please enter a valid phone number including the area or country code.';
      error.focus();
      return;
    }
    if (value('preferred') === 'Email' && !email) {
      error.textContent = 'Enter an email address for your preferred contact method.';
      error.focus();
      return;
    }
    if (value('preferred') !== 'Email' && !phone) {
      error.textContent =
        'Enter a phone number for your preferred contact method, or select Email.';
      error.focus();
      return;
    }
    reference ||= createReference();
    message = buildMessage(
      {
        type: value('type'),
        name: value('name'),
        company: value('company'),
        phone,
        email,
        machineType: value('machineType'),
        machineModel: value('machineModel'),
        category: value('category'),
        details: value('details'),
        preferred: value('preferred'),
        attachmentNames: Array.from(attachment.files || []).map((f) => f.name),
      },
      getItems(),
      reference,
    );
    const href = whatsappUrl(message);
    const longMessage = href.length > 7000;
    const destination = longMessage ? href.split('?')[0]! : href;
    (document.getElementById('whatsapp-open') as HTMLAnchorElement).href = destination;
    document.getElementById('handoff-status')!.textContent = longMessage
      ? 'This requirement is too long for a reliable WhatsApp link. Copy the requirement below, open WhatsApp, paste it into the conversation and attach your files.'
      : 'Your requirement is ready. Review it in WhatsApp, attach any files, then send.';
    document.getElementById('message-preview')!.textContent = message;
    document.getElementById('whatsapp-result')!.hidden = false;
    if (!longMessage) window.open(destination, '_blank', 'noopener,noreferrer');
    document.getElementById('whatsapp-result')!.scrollIntoView({
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      block: 'nearest',
    });
  });
  document.getElementById('copy-message')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(message);
      document.getElementById('copy-status')!.textContent = 'Requirement copied.';
    } catch {
      document.getElementById('copy-status')!.textContent =
        'Copy is unavailable. Expand Review message and select the text.';
    }
  });
</script>
