---
interface Props {
  white?: boolean;
}
const { white = false } = Astro.props;
---

<a class="brand" href="/" aria-label="SHK Tech Services home">
  <img
    src={`/images/logos/SHK-logo${white ? '-white' : ''}.svg`}
    width="1762"
    height="1636"
    alt="SHK Tech Services"
  />
  <span class="brand-wordmark" aria-hidden="true">
    <span class="brand-name-line">
      <strong>SHK</strong><b>TECH</b>
    </span>
    <span class="brand-sub">SERVICES</span>
  </span>
</a>
