---
interface Props {
  white?: boolean;
}
const { white = false } = Astro.props;
---

<a class="brand" href="/" aria-label="SHK Tech Services home">
  <img
    src={`/images/logos/SHK-logo${white ? '-white' : ''}.svg`}
    width="1762"
    height="1636"
    alt="SHK Tech Services"
  />
  <span class="brand-wordmark" aria-hidden="true" style="display:flex;flex-direction:column;align-items:flex-start;line-height:1;">
    <span class="brand-name-line"><strong>SHK</strong><b>TECH</b></span>
    <span class="brand-sub" style="display:block;margin-top:4px;padding-top:0;font-size:10px;line-height:1;letter-spacing:.26em;white-space:nowrap;">SERVICES</span>
  </span>
</a>
