---
import { Image } from 'astro:assets';
import sump from '../../assets/sump.webp';
import SectionHeader from '../global/SectionHeader.astro';
import SpecTable from '../products/SpecTable.astro';
import { compactorSpecs } from '../../data/products';
import { Check } from '@lucide/astro';
---

<section class="section paper chip-coolant-source" id="chip-coolant">
  <div class="container">
    <SectionHeader
      eyebrow="05 — CHIP & COOLANT"
      title="Cleaner sumps. Denser scrap. Less downtime."
    />
    <div class="coolant-source-grid">
      <figure class="sump-image">
        <Image
          src={sump}
          alt="Oilmax sump cleaning equipment and before/after coolant images from the SHK catalogue"
          loading="lazy"
          widths={[400, 662]}
          sizes="(max-width: 768px) 90vw, 38vw"
        />
        <figcaption class="mono">SUMP CLEANING SYSTEM · SOURCE: SHK CATALOGUE</figcaption>
      </figure>

      <div class="sump-benefits">
        <p class="eyebrow">SUMP CLEANING</p>
        <h3>Keep the fluid working.</h3>
        <ul>
          {[
            'No filter element to replace',
            'Reduced coolant consumption',
            'Extended coolant change period',
            'Reduced machine downtime',
            'Improved EHS compliance',
          ].map((item) => (
            <li><Check size={15} stroke-width={2} /> {item}</li>
          ))}
        </ul>
        <a class="text-link" href="/products/coolant-filtration/">Explore coolant solutions ↗</a>
      </div>

      <div class="spec-panel">
        <p class="eyebrow">CHIP COMPACTION / VCC SERIES</p>
        <h3>Make more of the swarf.</h3>
        <SpecTable
          headers={['Model', 'VCC 12-110', 'VCC 10-150']}
          rows={compactorSpecs}
          caption="Chip compactor specifications"
        />
        <p class="small">
          Aluminium, MS, cast iron, brass, copper, SS burr and grinding dust.
        </p>
        <a class="text-link" href="/products/chip-compactors/">View compaction range ↗</a>
      </div>
    </div>
  </div>
</section>
