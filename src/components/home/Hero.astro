---
import { Image } from 'astro:assets';
import probe from '../../assets/probe.webp';
import Button from '../global/Button.astro';
import { brands } from '../../data/brands';
---

<section class="hero dark">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker">WORKHOLDING · METROLOGY · CHIP &amp; COOLANT · MACHINE SERVICES</p>
      <h1>
        <span class="hero-line-one">Engineering solutions for</span>
        <span class="hero-line-two">CNC manufacturing<span class="hero-dot">.</span></span>
      </h1>
      <p class="hero-description">
        Workholding, tooling, probing, calibration and chip &amp; coolant systems from global
        technology leaders. Selected, installed and serviced by engineers in Bengaluru.
      </p>
      <div class="button-row">
        <Button href="#requirement">Talk to an Engineer</Button>
        <Button href="#machine" secondary>Explore the Machine</Button>
      </div>
      <div class="hero-values" aria-label="Precision, productivity and uptime">
        <span>Precision</span>
        <span>Productivity</span>
        <span>Uptime</span>
      </div>
    </div>
    <figure class="hero-visual">
      <Image
        src={probe}
        alt="Tool measurement inside a CNC machine, from the SHK probing catalogue"
        widths={[480, 720, 997]}
        sizes="(max-width: 767px) 92vw, 48vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span class="mono">PROBING &amp; TOOL SETTING</span>
        <strong>Precision begins at the point of contact.</strong>
        <span class="image-note">Catalogue image · application context</span>
      </figcaption>
    </figure>
  </div>
  <div class="container technology-strip">
    <span class="mono">TECHNOLOGY WE WORK WITH</span>
    <div>
      {brands.map((b) => <span>{b.name}</span>)}
    </div>
  </div>
</section>
