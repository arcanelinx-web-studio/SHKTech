---
import { Image } from 'astro:assets';
import probe from '../../assets/probe.webp';
import Button from '../global/Button.astro';
---

<section class="hero dark">
  <div class="container hero-grid" style="width:100%;max-width:none;box-sizing:border-box;padding-left:clamp(20px,3.25vw,68px);padding-right:clamp(20px,3.25vw,68px);">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker">WORKHOLDING · METROLOGY · CHIP &amp; COOLANT · MACHINE SERVICES</p>
      <h1>
        <span class="hero-line-one">Engineering solutions for</span>
        <span class="hero-line-two">CNC manufacturing<span class="hero-dot">.</span></span>
      </h1>
      <p class="hero-description">
        Workholding, tooling, probing, calibration and chip &amp; coolant systems from global
        technology leaders. Selected, installed and serviced by engineers in Bengaluru.
      </p>
      <div class="button-row">
        <Button href="#requirement">Talk to an Engineer</Button>
        <Button href="#machine" secondary>Explore the Machine</Button>
      </div>
      <div class="hero-values" aria-label="Precision, productivity and uptime">
        <span>Precision</span>
        <span>Productivity</span>
        <span>Uptime</span>
      </div>
    </div>
    <figure class="hero-visual">
      <Image
        src={probe}
        alt="Tool measurement inside a CNC machine"
        widths={[480, 720, 997]}
        sizes="(max-width: 767px) 92vw, 48vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span class="mono">PROBING &amp; TOOL SETTING</span>
        <strong>Precision begins at the point of contact.</strong>
        <span class="image-note">CNC probing · application context</span>
      </figcaption>
    </figure>
  </div>
  <div class="container technology-strip" style="width:100%;max-width:none;box-sizing:border-box;padding-left:clamp(20px,3.25vw,68px);padding-right:clamp(20px,3.25vw,68px);">
    <span class="mono">TECHNOLOGY WE WORK WITH</span>
    <div class="technology-logo-panel">
      <img
        src="/images/client-brand-logos.webp"
        width="880"
        height="200"
        loading="eager"
        alt="Technology logos supplied by SHK: LK, TaeguTec, SolidCAM, Detron, Air Seiki, VGS & Co, Marposs and Oilmax"
      />
    </div>
  </div>
</section>
