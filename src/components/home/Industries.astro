---
import { industries } from '../../data/industries';
---

<section class="industries-source" id="industries">
  <div class="container">
    <div class="industries-heading">
      <div><p class="eyebrow">APPLICATION CONTEXT</p><p class="industry-context-note">Examples of manufacturing sectors where these CNC technologies are commonly applied.</p></div>
      <a class="text-link" href="/#requirement">Discuss your application ↗</a>
    </div>
    <div class="industry-strip-list">
      {industries.map((industry) => (
        <a href={`/?industry=${encodeURIComponent(industry.name)}#requirement`}>{industry.name}</a>
      ))}
    </div>
  </div>
</section>
