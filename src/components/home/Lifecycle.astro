---
import SectionHeader from '../global/SectionHeader.astro';

const stages = [
  ['Select', 'The right technology for the part.', '/products/'],
  ['Install', 'Integrated on your machine.', '/services/retrofit/'],
  ['Calibrate', 'Geometry and accuracy verified.', '/services/laser-calibration/'],
  ['Optimise', 'Workholding, tooling and CAM.', '/solutions/capability/'],
  ['Maintain', 'Chips, coolant and clean air.', '/solutions/coolant/'],
  ['Recondition', 'Spindles, screws and guideways.', '/services/machine-reconditioning/'],
  ['Retrofit', 'New subsystems, longer life.', '/services/retrofit/'],
];
---

<section class="section dark lifecycle">
  <div class="container">
    <SectionHeader eyebrow="06 — THE LIFE OF YOUR MACHINE" title="From first setup to second life." />
    <div class="source-lifecycle">
      {stages.map(([name, copy, href], i) => (
        <a href={href}>
          <span class="lifecycle-node" aria-hidden="true"></span>
          <span class="source-stage-number mono">0{i + 1}</span>
          <h3>{name}</h3>
          <p>{copy}</p>
        </a>
      ))}
    </div>
  </div>
</section>
