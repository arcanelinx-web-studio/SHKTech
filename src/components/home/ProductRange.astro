---
import { Image } from 'astro:assets';
import SectionHeader from '../global/SectionHeader.astro';
import EnquiryButton from '../enquiry/EnquiryButton.astro';
import { products } from '../../data/products';

const shown = products.slice(0, 8);
---

<section class="section paper product-range" id="products">
  <div class="container">
    <SectionHeader
      eyebrow="03 — PRODUCT RANGE"
      title="For the spindle, the table and everything around it."
    >
      <a class="text-link" href="/products/">Browse all {products.length} categories ↗</a>
    </SectionHeader>

    <div class="source-product-grid">
      {shown.map((product) => (
        <article class="source-product-card">
          <a
            class="source-product-image"
            href={`/products/${product.id}/`}
            aria-label={`View ${product.title}`}
          >
            {product.image ? (
              <Image
                src={product.image}
                alt={product.title}
                widths={[220, 360]}
                sizes="(max-width: 600px) 46vw, (max-width: 900px) 42vw, 260px"
                loading="lazy"
              />
            ) : (
              <span class="mono">TECHNICAL IMAGE<br />AVAILABLE ON REQUEST</span>
            )}
          </a>
          <div class="source-product-body">
            <p class="eyebrow">{product.label}</p>
            <h3><a href={`/products/${product.id}/`}>{product.title}</a></h3>
            <p>{product.description}</p>
            <div class="source-product-actions">
              <a class="text-link" href={`/products/${product.id}/`}>View range ↗</a>
              <EnquiryButton id={product.id} title={product.title} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
