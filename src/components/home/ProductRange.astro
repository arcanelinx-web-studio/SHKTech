---
import { Image } from 'astro:assets';
import SectionHeader from '../global/SectionHeader.astro';
import EnquiryButton from '../enquiry/EnquiryButton.astro';
import { products } from '../../data/products';
const featured = products[0]!;
const supporting = products.slice(1, 3);
const indexed = products.slice(3, 6);
---

<section class="section paper product-range" id="products">
  <div class="container">
    <SectionHeader
      eyebrow="03 — PRODUCT RANGE"
      title="For the spindle, the table and everything around it."
    >
      <a class="text-link" href="/products/">Explore all {products.length} categories ↗</a>
    </SectionHeader>

    <div class="product-editorial">
      <article class="product-feature">
        <a class="product-feature-image" href={`/products/${featured.id}/`} aria-label={`View ${featured.title}`}>
          {featured.image && (
            <Image
              src={featured.image}
              alt={featured.title}
              widths={[420, 720]}
              sizes="(max-width: 850px) 92vw, 55vw"
              loading="lazy"
            />
          )}
        </a>
        <div class="product-feature-copy">
          <p class="eyebrow">{featured.label}</p>
          <h3><a href={`/products/${featured.id}/`}>{featured.title}</a></h3>
          <p>{featured.description}</p>
          <div class="product-actions">
            <a class="text-link" href={`/products/${featured.id}/`}>View range ↗</a>
            <EnquiryButton id={featured.id} title={featured.title} />
          </div>
        </div>
      </article>

      <div class="product-supporting">
        {supporting.map((p) => (
          <article class="product-story">
            <a class="product-story-image" href={`/products/${p.id}/`} aria-label={`View ${p.title}`}>
              {p.image && (
                <Image
                  src={p.image}
                  alt={p.title}
                  widths={[300, 480]}
                  sizes="(max-width: 850px) 92vw, 32vw"
                  loading="lazy"
                />
              )}
            </a>
            <div>
              <p class="eyebrow">{p.label}</p>
              <h3><a href={`/products/${p.id}/`}>{p.title}</a></h3>
              <p>{p.description}</p>
              <div class="product-actions">
                <a class="text-link" href={`/products/${p.id}/`}>View range ↗</a>
                <EnquiryButton id={p.id} title={p.title} />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="product-index-list" aria-label="More product categories">
      {indexed.map((p, i) => (
        <article class="product-index-row">
          <span class="mono">0{i + 4}</span>
          <div>
            <p class="eyebrow">{p.label}</p>
            <h3><a href={`/products/${p.id}/`}>{p.title}</a></h3>
          </div>
          <p>{p.description}</p>
          <div class="product-index-actions">
            <EnquiryButton id={p.id} title={p.title} />
            <a class="text-link" href={`/products/${p.id}/`}>View ↗</a>
          </div>
        </article>
      ))}
    </div>

    <a class="range-banner" href="/products/">
      <span class="mono">COMPLETE SHK RANGE</span>
      <span>Chip handling. Coolant. Measurement. Cleaning. CAM.</span>
      <span>View all categories ↗</span>
    </a>
  </div>
</section>
