---
import SectionHeader from '../global/SectionHeader.astro';
import { machineZones } from '../../data/machineZones';
import type { MachineZone } from '../../data/types';
import { getProduct } from '../../data/products';
import { services } from '../../data/services';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro';

const relatedFor = (zone: MachineZone) => [
  ...zone.products.map((id: string) => ({ title: getProduct(id)?.title, href: `/products/${id}/` })),
  ...zone.services.map((id: string) => ({
    title: services.find((s) => s.id === id)?.title,
    href: `/services/${id}/`,
  })),
].filter((item) => item.title);
---

<section class="section dark explorer" id="machine">
  <div class="container">
    <SectionHeader
      eyebrow="02 — EXPLORE THE MACHINE"
      title="Every zone of your machine. One partner."
      description="Select a point on the machining centre to see what SHK supplies and services there."
    />

    <div class="explorer-layout">
      <div class="machine-drawing">
        <div class="drawing-heading mono">
          <span>VERTICAL MACHINING CENTRE · FRONT VIEW</span>
          <span>09 CONNECTED ZONES</span>
        </div>

        <svg
          viewBox="0 0 660 540"
          role="img"
          aria-label="Schematic front view of a vertical machining centre"
        >
          <defs>
            <pattern id="grid" width="30" height="30" patternUnits="userSpaceOnUse">
              <path d="M30 0H0V30" fill="none" stroke="#22303a" stroke-width=".6" />
            </pattern>
            <linearGradient id="machine-face" x2="1" y2="1">
              <stop stop-color="#202f3a" />
              <stop offset="1" stop-color="#111b23" />
            </linearGradient>
          </defs>
          <rect width="660" height="540" fill="url(#grid)" />
          <g fill="url(#machine-face)" stroke="#657783" stroke-width="1.4">
            <path d="M111 131 140 95h315l32 37v319H111Z" />
            <path d="M129 148h302v254H129z" />
            <path d="M140 95h315v36H111m320 17 38-16v269l-38 1" />
            <path d="M99 451h400v32H99zM125 483v16h55v-16m226 0v16h58v-16" />
            <path d="M290 148h72v66h-72zM303 214h46v23h-46zM314 237h24v33h-24z" data-machine-part="01" />
            <path d="M333 270v33m-5 0h10" data-machine-part="02" />
            <path d="M173 376h218v27H173zM194 403h183v25H194z" data-machine-part="05" />
            <path d="M205 324h72v52h-72z" data-machine-part="03" />
            <ellipse cx="241" cy="347" rx="27" ry="20" data-machine-part="03" />
            <path d="M292 346h98v30h-98zM304 334h16v27h-16zM363 334h16v27h-16z" data-machine-part="04" />
            <path d="m468 419 63-40 26 18-65 42v42h-24zM531 379v-17l26 15v20m-24 8v56h51v-35l-27-29" data-machine-part="06" />
            <path d="M397 445h64v48h-64z" data-machine-part="07" />
            <path d="M146 82h67v42h-67zM159 82V63h40v19m-33 42v24" data-machine-part="08" />
            <path d="M487 174h97v116h-97zM498 187h75v51h-75zM503 252h12m9 0h12m9 0h12m-54 14h12m9 0h12m9 0h12M485 211h-17" data-machine-part="09" />
          </g>
          <g fill="none" stroke="#586c79" stroke-width="1">
            <path d="M142 163v219m15-219v219m246-219v219m12-219v219M184 384h194m-194 8h194M277 157h-74v133h42M172 432h200" />
            <path d="M73 356v61h47m-47-61-4 9m4-9 4 9m43 52-9-4m9 4-9 4" />
          </g>
          <g fill="#9aabb7" font-size="10" font-family="monospace">
            <text x="66" y="344">Z</text>
            <text x="124" y="421">X</text>
            <text x="170" y="523">SCHEMATIC · NOT TO SCALE</text>
          </g>
        </svg>

        {machineZones.map((zone, i) => (
          <button
            class:list={['hotspot', { active: i === 0 }]}
            style={`--x:${(zone.x / 660) * 100}%;--y:${(zone.y / 540) * 100}%`}
            data-zone={zone.id}
            aria-label={`${zone.id} ${zone.title}`}
            aria-pressed={i === 0}
          >
            {zone.id}
          </button>
        ))}
      </div>

      <div class="zone-stage" aria-live="polite">
        {machineZones.map((zone, i) => (
          <article class="zone-detail-panel" data-zone-detail={zone.id} hidden={i !== 0}>
            <div class="zone-panel-meta">
              <span class="mono">ZONE {zone.id} / 09</span>
              <span class="mono">{zone.title.toUpperCase()}</span>
            </div>
            <h3>{zone.title}</h3>
            <p class="zone-panel-description">{zone.description}</p>
            <ul class="zone-panel-list">
              {relatedFor(zone).map((item) => (
                <li>
                  <a href={item.href}>{item.title}</a>
                </li>
              ))}
            </ul>
            <div class="zone-panel-actions">
              <a
                class="button button-primary"
                href={zone.products[0] ? `/products/${zone.products[0]}/` : `/services/${zone.services[0]}/`}
              >
                View this range <ArrowUpRight size={16} />
              </a>
              <a
                class="button button-secondary"
                href={`/?details=${encodeURIComponent('I would like to discuss ' + zone.title + '.')}#requirement`}
              >
                Ask an engineer
              </a>
              <div class="zone-panel-nav" aria-label="Machine zones">
                <button type="button" data-zone-prev aria-label="Previous zone"><ArrowLeft size={16} /></button>
                <button type="button" data-zone-next aria-label="Next zone"><ArrowRight size={16} /></button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="zone-list mobile-zone-list">
        {machineZones.map((zone, i) => (
          <details class="zone" name="machine-zone" open={i === 0} data-zone-panel={zone.id}>
            <summary>
              <span class="zone-number mono">{zone.id}</span>
              <span>{zone.title}</span>
              <span class="zone-sign" aria-hidden="true">+</span>
            </summary>
            <div class="zone-content">
              <p>{zone.description}</p>
              <ul>
                {relatedFor(zone).map((item) => (
                  <li><a href={item.href}>{item.title} ↗</a></li>
                ))}
              </ul>
              <div class="button-row">
                <a
                  class="text-link"
                  href={zone.products[0] ? `/products/${zone.products[0]}/` : `/services/${zone.services[0]}/`}
                >
                  View this range ↗
                </a>
                <a
                  class="text-link subtle"
                  href={`/?details=${encodeURIComponent('I would like to discuss ' + zone.title + '.')}#requirement`}
                >
                  Ask an engineer ↗
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const zones = [...document.querySelectorAll<HTMLButtonElement>('[data-zone]')];
  const desktopPanels = [...document.querySelectorAll<HTMLElement>('[data-zone-detail]')];
  const mobilePanels = [...document.querySelectorAll<HTMLDetailsElement>('[data-zone-panel]')];

  function zoneIndex(id: string) {
    return zones.findIndex((zone) => zone.dataset.zone === id);
  }

  function highlight(id: string) {
    zones.forEach((button) => {
      const active = button.dataset.zone === id;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    document.querySelectorAll<SVGElement>('[data-machine-part]').forEach((part) => {
      part.classList.toggle('illuminated', part.dataset.machinePart === id);
    });

    desktopPanels.forEach((panel) => {
      panel.hidden = panel.dataset.zoneDetail !== id;
    });
  }

  function activate(id: string) {
    highlight(id);
  }

  zones.forEach((button) => {
    button.addEventListener('click', () => activate(button.dataset.zone!));
    button.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') activate(button.dataset.zone!);
    });
  });

  mobilePanels.forEach((panel) => {
    panel.addEventListener('toggle', () => {
      if (panel.open) highlight(panel.dataset.zonePanel!);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-zone-prev], [data-zone-next]').forEach((button) => {
    button.addEventListener('click', () => {
      const current = zones.find((zone) => zone.getAttribute('aria-pressed') === 'true')?.dataset.zone || '01';
      const currentIndex = zoneIndex(current);
      const delta = button.hasAttribute('data-zone-next') ? 1 : -1;
      const next = zones[(currentIndex + delta + zones.length) % zones.length]?.dataset.zone;
      if (next) activate(next);
    });
  });

  highlight('01');
</script>
