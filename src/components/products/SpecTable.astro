---
interface Props {
  headers: string[];
  rows: string[][];
  caption: string;
}
const { headers, rows, caption } = Astro.props;
const captionId = `spec-${caption
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '')}`;
---

<div class="spec-table-block">
  <p class="spec-table-caption" id={captionId}>{caption}</p>
  <div class="table-scroll" role="region" aria-labelledby={captionId} tabindex="0">
    <table aria-labelledby={captionId}>
      <thead>
        <tr>
          {headers.map((h) => (
            <th scope="col">{h}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {row.map((v, i) => (i === 0 ? <th scope="row">{v}</th> : <td class="mono">{v}</td>))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
