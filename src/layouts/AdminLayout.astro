---
import '../styles/global.css';

interface Props {
  title: string;
  login?: boolean;
}
const { title, login = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="theme-color" content="#0b1115" />\n    <link rel="preconnect" href="https://fonts.googleapis.com" />\n    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />\n    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} · SHK Tech Services</title>
  </head>
  <body class:list={['admin-body', { 'admin-login-body': login }]}>
    <slot />
  </body>
</html>
