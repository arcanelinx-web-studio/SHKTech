---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SHK Admin" noindex>
  <section class="section paper admin-shell">
    <div class="container">
      <div class="admin-heading">
        <div>
          <p class="eyebrow">SHK INTERNAL / ENQUIRY MANAGEMENT</p>
          <h1 class="page-title">SHK Lead Desk.</h1>
          <p class="lead">A private workspace for SHK to review enquiries, track quotations and manage follow-up.</p>
        </div>
        <button id="logout" class="button button-secondary" hidden>Sign out</button>
      </div>

      <div id="showcase-banner" class="showcase-banner" hidden>
        <div>
          <span class="mono">INTERACTIVE CLIENT SHOWCASE</span>
          <strong>Try the complete lead flow before production hosting.</strong>
          <p>Enquiries submitted on this GitHub Pages preview appear here in this browser. Production login, shared database, email delivery and private file storage activate on Hostinger.</p>
        </div>
        <a class="button button-secondary" href="/#requirement">Create preview enquiry ↗</a>
      </div>

      <section id="login-panel" class="admin-login">
        <div>
          <p class="eyebrow">SECURE ACCESS</p>
          <h2>SHK team access</h2>
          <p>Sign in to open the enquiry and follow-up workspace. Production credentials remain private to SHK.</p>
        </div>
        <form id="login-form">
          <label>
            Username
            <input name="username" autocomplete="username" required />
          </label>
          <label>
            Password
            <input name="password" type="password" autocomplete="current-password" required />
          </label>
          <button class="button button-primary" type="submit">Open lead desk</button>
          <p id="login-error" class="form-error" role="alert"></p>
        </form>
      </section>

      <section id="dashboard" hidden>
        <div class="admin-toolbar">
          <div class="admin-metrics" id="metrics"></div>
          <div class="admin-filters">
            <label>
              Search
              <input id="lead-search" type="search" placeholder="Name, company, reference, product" />
            </label>
            <label>
              Stage
              <select id="stage-filter">
                <option value="">All stages</option>
                <option>New</option>
                <option>Contacted</option>
                <option>Qualified</option>
                <option>Quotation</option>
                <option>Follow-up</option>
                <option>Won</option>
                <option>Lost</option>
              </select>
            </label>
            <button id="refresh" class="button button-secondary">Refresh</button>
            <button id="reset-showcase" class="button button-secondary" hidden>Reset demo data</button>
          </div>
        </div>
        <p id="dashboard-status" class="field-hint" role="status"></p>
        <div id="lead-list" class="lead-list"></div>
      </section>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .admin-shell{min-height:76vh;background:#f4f6f4}
  .admin-shell>.container{max-width:1500px}
  .admin-heading{display:flex;justify-content:space-between;gap:36px;align-items:center;margin-bottom:34px;padding-bottom:28px;border-bottom:1px solid #d7dfe2}
  .admin-heading .page-title{max-width:none;margin-bottom:10px}
  .admin-heading .lead{max-width:780px;margin:0}
  .showcase-banner{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:30px;align-items:center;margin:0 0 28px;padding:20px 22px;border:1px solid #c9d7dc;border-left:3px solid #8cc63f;background:#eef3f4}
  .showcase-banner .mono{color:#46606e}
  .showcase-banner strong{display:block;margin:6px 0 4px;font-size:16px}
  .showcase-banner p{margin:0;max-width:820px;font-size:12px;line-height:1.6;color:#63727b}
  .admin-login{display:grid;grid-template-columns:minmax(0,.9fr) minmax(360px,1.1fr);gap:72px;max-width:1180px;border:1px solid #d9dfe1;background:#fff;padding:52px 56px;box-shadow:0 18px 50px rgba(23,36,44,.06)}
  .admin-login h2{font-size:34px;line-height:1.08;margin:8px 0 14px}
  .admin-login p{max-width:470px}
  .admin-login form{display:grid;gap:20px;padding:8px 0}
  .admin-login label,.admin-filters label{display:grid;gap:8px;font-size:11px;font-weight:600;color:#263944}
  .admin-login input,.admin-filters input,.admin-filters select,.lead-card select,.lead-card textarea{
    width:100%;border:1px solid #cbd5da;background:#fff;padding:12px 13px;border-radius:2px;color:#18222a;box-sizing:border-box
  }
  .admin-login input:focus,.admin-filters input:focus,.admin-filters select:focus,.lead-card select:focus,.lead-card textarea:focus{outline:none;border-color:#0878ac;box-shadow:0 0 0 1px #0878ac}
  .admin-toolbar{display:grid;gap:18px;margin-bottom:18px}
  .admin-metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
  .metric{position:relative;border:1px solid #d8e0e3;background:#fff;padding:18px 20px;min-height:84px;display:flex;flex-direction:column;justify-content:center}
  .metric:before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:#9bb0bb}
  .metric:nth-child(2):before{background:#1e8fe1}.metric:nth-child(3):before{background:#f0a12a}.metric:nth-child(4):before{background:#8c6dd7}.metric:nth-child(5):before{background:#62a846}
  .metric strong{display:block;font-size:28px;line-height:1;letter-spacing:-.04em;color:#17232b}
  .metric span{margin-top:8px;font:10px Barlow,sans-serif;color:#63727b;text-transform:uppercase;letter-spacing:.09em}
  .admin-filters{display:grid;grid-template-columns:minmax(280px,1.45fr) minmax(180px,.55fr) auto auto;align-items:end;gap:10px;padding:16px;border:1px solid #d8e0e3;background:#fff}
  #dashboard-status{margin:0 0 12px;color:#6b7b84}
  .lead-list{display:grid;gap:12px}
  .lead-card{overflow:hidden;border:1px solid #d8e0e3;background:#fff;box-shadow:0 4px 14px rgba(18,34,44,.025)}
  .lead-summary{display:grid;grid-template-columns:150px minmax(220px,1.05fr) minmax(220px,.95fr) 170px 116px;gap:20px;padding:18px 20px;align-items:center}
  .lead-summary strong{display:block;font-size:14px;line-height:1.35;margin-bottom:4px;color:#17232b}
  .lead-ref{font:10px Barlow,sans-serif;color:#0878ac;letter-spacing:.07em}
  .lead-meta{font-size:11.5px;color:#6b7b84;line-height:1.55}
  .lead-stage{display:grid;gap:5px;margin:0}
  .lead-stage .mono{font-size:8px;color:#667985}
  .lead-stage select{min-height:38px;padding:8px 10px;font-size:11.5px}
  .lead-toggle{min-height:38px;padding:9px 11px!important;font-size:10px!important;white-space:nowrap}
  .lead-detail{border-top:1px solid #e3e8ea;padding:24px 20px 26px;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(330px,.85fr);gap:42px;background:#fbfcfb}
  .lead-detail[hidden]{display:none!important}
  .lead-detail h3{font-size:18px;margin:0 0 12px;letter-spacing:-.02em}
  .lead-detail p{font-size:12.5px;margin:9px 0;line-height:1.65}
  .lead-requirement{padding-right:12px}
  .lead-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 24px;margin-top:18px;padding-top:16px;border-top:1px solid #e1e7e9}
  .lead-facts p{margin:0}
  .lead-actions{display:grid;gap:16px;padding-left:28px;border-left:1px solid #e1e7e9}
  .lead-actions label{display:grid;gap:7px}
  .lead-actions textarea{min-height:106px;resize:vertical}
  .lead-actions [data-save]{justify-self:start;min-width:130px}
  .catalogue-panel{padding:16px;border:1px solid #dce4e7;background:#fff}
  .catalogue-panel h3{font-size:14px;margin-bottom:8px}
  .catalogue-links{display:grid;gap:7px}
  .catalogue-links a{color:#0878ac;font-size:11.5px;font-weight:600}
  .attachment-list{margin-top:14px;padding-top:14px;border-top:1px solid #e1e7e9}
  .attachment-list .text-link{font-size:11.5px}
  .empty-admin{padding:44px;border:1px dashed #bbc7cc;text-align:center;background:#fff;color:#657680}
  @media(max-width:1100px){
    .lead-summary{grid-template-columns:135px 1fr 1fr 155px}
    .lead-toggle{grid-column:4;justify-self:stretch}
    .lead-detail{gap:28px}
  }
  @media(max-width:900px){
    .showcase-banner{grid-template-columns:1fr;gap:18px;padding:21px}
    .showcase-banner .button{width:100%}
    .admin-login{grid-template-columns:1fr;gap:24px;padding:28px}
    .admin-metrics{grid-template-columns:repeat(2,1fr)}
    .admin-filters{grid-template-columns:1fr}
    .admin-heading{align-items:flex-start}
    .lead-summary{grid-template-columns:1fr 1fr}
    .lead-stage,.lead-toggle{grid-column:auto}
    .lead-detail{grid-template-columns:1fr}
    .lead-actions{padding-left:0;border-left:0;border-top:1px solid #e1e7e9;padding-top:20px}
  }
  @media(max-width:620px){
    .admin-heading{flex-direction:column}
    .admin-metrics{grid-template-columns:1fr 1fr}
    .lead-summary{grid-template-columns:1fr}
    .lead-facts{grid-template-columns:1fr}
  }
</style>

<script>
  import { isShowcaseMode, loadShowcaseLeads, resetShowcaseLeads, updateShowcaseLead } from '../utils/showcase';

  const showcase = isShowcaseMode();
  const SHOWCASE_AUTH_KEY = 'shk_showcase_admin_auth_v1';
  const SHOWCASE_USER = 'shk';
  const SHOWCASE_PASSWORD = 'SHK@Preview2026';
  const loginPanel = document.getElementById('login-panel')!;
  const dashboard = document.getElementById('dashboard')!;
  const logout = document.getElementById('logout') as HTMLButtonElement;
  const list = document.getElementById('lead-list')!;
  const status = document.getElementById('dashboard-status')!;
  const search = document.getElementById('lead-search') as HTMLInputElement;
  const stageFilter = document.getElementById('stage-filter') as HTMLSelectElement;

  function esc(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;',
    }[c] || c));
  }

  function fmtDate(value: string) {
    try { return new Intl.DateTimeFormat('en-IN',{dateStyle:'medium',timeStyle:'short'}).format(new Date(value)); }
    catch { return value; }
  }

  function metric(label: string, value: number) {
    return '<div class="metric"><strong>' + value + '</strong><span>' + esc(label) + '</span></div>';
  }

  function render(leads: any[]) {
    const metrics = document.getElementById('metrics')!;
    metrics.innerHTML =
      metric('Total', leads.length) +
      metric('New', leads.filter((l) => l.stage === 'New').length) +
      metric('Quotation', leads.filter((l) => l.stage === 'Quotation').length) +
      metric('Follow-up', leads.filter((l) => l.stage === 'Follow-up').length) +
      metric('Won', leads.filter((l) => l.stage === 'Won').length);

    if (!leads.length) {
      list.innerHTML = '<div class="empty-admin">No enquiries match this view.</div>';
      return;
    }

    list.innerHTML = leads.map((lead) => {
      const catalogues = Array.isArray(lead.catalogues) ? lead.catalogues : [];
      const items = Array.isArray(lead.items) ? lead.items : [];
      const delivery = lead.delivery || {};
      const attachments = Array.isArray(lead.attachments) ? lead.attachments : [];
      const contact = [lead.phone, lead.email].filter(Boolean).join(' · ');
      const stageSlug = String(lead.stage || 'New').toLowerCase().replace(/[^a-z]+/g,'-');
      return '<article class="lead-card stage-' + esc(stageSlug) + '" data-id="' + lead.id + '">' +
        '<div class="lead-summary">' +
          '<div><span class="lead-ref">' + esc(lead.reference) + '</span><div class="lead-meta">' + esc(fmtDate(lead.created_at)) + '</div></div>' +
          '<div><strong>' + esc(lead.name) + '</strong><div class="lead-meta">' + esc(lead.company || 'Individual enquiry') + '<br>' + esc(contact || 'No contact supplied') + '</div></div>' +
          '<div><strong>' + esc(lead.category || lead.type || 'General requirement') + '</strong><div class="lead-meta">' + esc(lead.location || 'Location not supplied') + (lead.brand ? ' · ' + esc(lead.brand) : '') + '</div></div>' +
          '<label class="lead-stage"><span class="mono">STAGE</span><select data-stage>' +
            ['New','Contacted','Qualified','Quotation','Follow-up','Won','Lost'].map((s) => '<option' + (lead.stage===s?' selected':'') + '>' + s + '</option>').join('') +
          '</select></label>' +
          '<button class="button button-secondary lead-toggle" type="button" data-toggle aria-expanded="false">View details</button>' +
        '</div>' +
        '<div class="lead-detail" data-detail hidden>' +
          '<div class="lead-requirement">' +
            '<span class="eyebrow">CUSTOMER REQUIREMENT</span>' +
            '<h3>' + esc(lead.category || lead.type || 'General requirement') + '</h3>' +
            '<p>' + esc(lead.details || 'No requirement details supplied.') + '</p>' +
            '<div class="lead-facts">' +
              '<p><strong>Application</strong><br>' + esc(lead.usage_application || '—') + '</p>' +
              '<p><strong>Quantity</strong><br>' + esc((lead.quantity || '—') + ' ' + (lead.quantity_unit || '')) + '</p>' +
              '<p><strong>Machine</strong><br>' + esc(((lead.machine_type || '') + ' ' + (lead.machine_model || '')).trim() || '—') + '</p>' +
              '<p><strong>Preferred contact</strong><br>' + esc(lead.preferred || '—') + '</p>' +
            '</div>' +
            (items.length ? '<p><strong>Selected solution:</strong> ' + items.map((i:any)=>esc(i.title)).join(' · ') + '</p>' : '') +
            (attachments.length ? '<div class="attachment-list"><span class="mono">ATTACHMENTS</span><br>' + attachments.map((a:any) => {
              if (typeof a === 'string') return '<span class="lead-meta">' + esc(a) + '</span>';
              return '<a class="text-link" href="/api/admin/file.php?key=' + encodeURIComponent(a.key) + '">' + esc(a.name) + ' ↗</a>';
            }).join('<br>') + '</div>' : '') +
          '</div>' +
          '<div class="lead-actions">' +
            '<div class="catalogue-panel"><span class="mono">CATALOGUE DELIVERY</span><h3>' + (catalogues.length ? 'Relevant SHK material' : 'No catalogue mapped') + '</h3><div class="catalogue-links">' +
              catalogues.map((c:any)=>'<a href="' + esc(c.url) + '" target="_blank" rel="noopener">' + esc(c.title) + ' ↗</a>').join('') +
            '</div><p class="lead-meta">' + (
              delivery.showcase
                ? 'Preview mode · catalogue ready'
                : 'Email: ' + esc(delivery.customerEmail?.sent ? 'sent' : delivery.customerEmail?.attempted ? 'failed' : 'not configured') +
                  ' · WhatsApp: ' + esc(delivery.whatsapp?.sent ? 'sent' : delivery.whatsapp?.attempted ? 'failed' : 'not configured')
            ) + '</p></div>' +
            '<label><span class="mono">INTERNAL NOTES</span><textarea rows="4" data-notes placeholder="Add quotation status, next action or follow-up note…">' + esc(lead.notes || '') + '</textarea></label>' +
            '<button class="button button-primary" data-save>Save update</button>' +
          '</div>' +
        '</div>' +
      '</article>';
    }).join('');

    list.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const card = button.closest<HTMLElement>('.lead-card')!;
        const detail = card.querySelector<HTMLElement>('[data-detail]')!;
        const open = detail.hidden;
        detail.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
        button.textContent = open ? 'Hide details' : 'View details';
      });
    });

    list.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((button) => {
      button.addEventListener('click', async () => {
        const card = button.closest<HTMLElement>('.lead-card')!;
        const id = Number(card.dataset.id);
        const stage = (card.querySelector('[data-stage]') as HTMLSelectElement).value;
        const notes = (card.querySelector('[data-notes]') as HTMLTextAreaElement).value;
        button.disabled = true;

        if (showcase) {
          const saved = updateShowcaseLead(id, stage, notes);
          button.disabled = false;
          status.textContent = saved
            ? 'Showcase lead updated in this browser.'
            : 'Could not update this showcase lead.';
          return;
        }

        const response = await fetch('/api/admin/leads.php', {
          method:'PATCH',
          headers:{'content-type':'application/json'},
          body:JSON.stringify({ id, stage, notes }),
        });
        button.disabled = false;
        status.textContent = response.ok ? 'Lead updated.' : 'Could not save this update.';
      });
    });
  }

  async function load() {
    status.textContent = 'Loading enquiries…';

    if (showcase) {
      const authenticated = sessionStorage.getItem(SHOWCASE_AUTH_KEY) === 'yes';
      const showcaseBanner = document.getElementById('showcase-banner')!;
      const resetButton = document.getElementById('reset-showcase') as HTMLButtonElement;

      if (!authenticated) {
        loginPanel.hidden = false;
        dashboard.hidden = true;
        logout.hidden = true;
        resetButton.hidden = true;
        showcaseBanner.hidden = false;
        showcaseBanner.querySelector('strong')!.textContent = 'Preview the SHK team login and lead-management workflow.';
        showcaseBanner.querySelector('p')!.textContent =
          'This public review build uses demo credentials only. The Hostinger production version uses private SHK credentials and a shared database.';
        status.textContent = '';
        return;
      }

      const query = search.value.trim().toLowerCase();
      const stage = stageFilter.value;
      const leads = loadShowcaseLeads().filter((lead) => {
        const haystack = [
          lead.reference,
          lead.name,
          lead.company,
          lead.phone,
          lead.email,
          lead.category,
          lead.type,
          lead.location,
        ].join(' ').toLowerCase();
        return (!query || haystack.includes(query)) && (!stage || lead.stage === stage);
      });

      loginPanel.hidden = true;
      dashboard.hidden = false;
      logout.hidden = false;
      logout.textContent = 'Sign out';
      resetButton.hidden = false;
      showcaseBanner.hidden = false;
      showcaseBanner.querySelector('strong')!.textContent = 'Interactive SHK lead desk preview.';
      showcaseBanner.querySelector('p')!.textContent =
        'Preview enquiries created in this browser appear here. Email, WhatsApp automation and shared storage activate only on the production Hostinger deployment.';
      status.textContent = leads.length + ' preview enquiries loaded · stored only in this browser.';
      render(leads);
      return;
    }

    document.getElementById('showcase-banner')!.hidden = true;
    const params = new URLSearchParams();
    if (search.value.trim()) params.set('q', search.value.trim());
    if (stageFilter.value) params.set('stage', stageFilter.value);
    const response = await fetch('/api/admin/leads.php?' + params.toString(), {headers:{accept:'application/json'}});
    if (response.status === 401) {
      loginPanel.hidden = false;
      dashboard.hidden = true;
      logout.hidden = true;
      status.textContent = '';
      return;
    }
    const data = await response.json().catch(() => ({ok:false,error:'Unable to read server response.'}));
    if (!response.ok || !data.ok) {
      dashboard.hidden = false;
      loginPanel.hidden = true;
      logout.hidden = false;
      status.textContent = data.error || 'Unable to load enquiries.';
      return;
    }
    loginPanel.hidden = true;
    dashboard.hidden = false;
    logout.hidden = false;
    logout.textContent = 'Sign out';
    status.textContent = data.leads.length + ' enquiries loaded.';
    render(data.leads);
  }

  document.getElementById('login-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const error = document.getElementById('login-error')!;
    error.textContent = '';
    if (showcase) {
      const username = String(data.get('username') || '');
      const password = String(data.get('password') || '');
      if (username !== SHOWCASE_USER || password !== SHOWCASE_PASSWORD) {
        error.textContent = 'Incorrect preview username or password.';
        return;
      }
      sessionStorage.setItem(SHOWCASE_AUTH_KEY, 'yes');
      form.reset();
      await load();
      return;
    }

    const response = await fetch('/api/admin/login.php', {
      method:'POST',
      headers:{'content-type':'application/json'},
      body:JSON.stringify({username:data.get('username'),password:data.get('password')}),
    });
    const result = await response.json().catch(() => ({ok:false,error:'Unable to sign in.'}));
    if (!response.ok || !result.ok) {
      error.textContent = result.error || 'Unable to sign in.';
      return;
    }
    form.reset();
    await load();
  });

  logout.addEventListener('click', async () => {
    if (showcase) {
      sessionStorage.removeItem(SHOWCASE_AUTH_KEY);
      search.value = '';
      stageFilter.value = '';
      await load();
      return;
    }
    await fetch('/api/admin/logout.php',{method:'POST'});
    await load();
  });

  document.getElementById('reset-showcase')?.addEventListener('click', async () => {
    if (!showcase) return;
    resetShowcaseLeads();
    search.value = '';
    stageFilter.value = '';
    status.textContent = 'Demo data restored.';
    await load();
  });

  document.getElementById('refresh')?.addEventListener('click', load);
  stageFilter.addEventListener('change', load);
  let timer:number;
  search.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(load, 300);
  });

  load();
</script>
