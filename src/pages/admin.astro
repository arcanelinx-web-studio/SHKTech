---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SHK Admin" noindex>
  <section class="section paper admin-shell">
    <div class="container">
      <div class="admin-heading">
        <div>
          <p class="eyebrow">SHK INTERNAL / ENQUIRY MANAGEMENT</p>
          <h1 class="page-title">Lead desk.</h1>
          <p class="lead">Website enquiries, catalogue delivery and follow-up status in one place.</p>
        </div>
        <button id="logout" class="button button-secondary" hidden>Sign out</button>
      </div>

      <section id="login-panel" class="admin-login">
        <div>
          <p class="eyebrow">SECURE ACCESS</p>
          <h2>SHK team login</h2>
          <p>Use the private credentials configured in the website deployment.</p>
        </div>
        <form id="login-form">
          <label>
            Username
            <input name="username" autocomplete="username" required />
          </label>
          <label>
            Password
            <input name="password" type="password" autocomplete="current-password" required />
          </label>
          <button class="button button-primary" type="submit">Open lead desk</button>
          <p id="login-error" class="form-error" role="alert"></p>
        </form>
      </section>

      <section id="dashboard" hidden>
        <div class="admin-toolbar">
          <div class="admin-metrics" id="metrics"></div>
          <div class="admin-filters">
            <label>
              Search
              <input id="lead-search" type="search" placeholder="Name, company, reference, product" />
            </label>
            <label>
              Stage
              <select id="stage-filter">
                <option value="">All stages</option>
                <option>New</option>
                <option>Contacted</option>
                <option>Qualified</option>
                <option>Quotation</option>
                <option>Follow-up</option>
                <option>Won</option>
                <option>Lost</option>
              </select>
            </label>
            <button id="refresh" class="button button-secondary">Refresh</button>
          </div>
        </div>
        <p id="dashboard-status" class="field-hint" role="status"></p>
        <div id="lead-list" class="lead-list"></div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .admin-shell{min-height:76vh}
  .admin-heading{display:flex;justify-content:space-between;gap:28px;align-items:flex-start;margin-bottom:42px}
  .admin-login{display:grid;grid-template-columns:1fr 1fr;gap:60px;max-width:960px;border:1px solid #d9dfe1;background:#fff;padding:42px}
  .admin-login form{display:grid;gap:18px}
  .admin-login label,.admin-filters label{display:grid;gap:8px;font-size:12px;font-weight:600}
  .admin-login input,.admin-filters input,.admin-filters select,.lead-card select,.lead-card textarea{
    width:100%;border:1px solid #ccd5d9;background:#fff;padding:12px 13px;border-radius:3px;color:#18222a
  }
  .admin-toolbar{display:grid;gap:24px;margin-bottom:22px}
  .admin-metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
  .metric{border:1px solid #d9dfe1;background:#fff;padding:18px}
  .metric strong{display:block;font-size:27px;letter-spacing:-.04em}
  .metric span{font:11px Barlow,sans-serif;color:#63727b;text-transform:uppercase;letter-spacing:.08em}
  .admin-filters{display:grid;grid-template-columns:1.4fr .7fr auto;align-items:end;gap:12px}
  .lead-list{display:grid;gap:14px}
  .lead-card{border:1px solid #d9dfe1;background:#fff}
  .lead-summary{display:grid;grid-template-columns:150px minmax(220px,1fr) 1fr 180px;gap:20px;padding:20px;align-items:center}
  .lead-summary strong{display:block;font-size:16px;margin-bottom:5px}
  .lead-ref{font:11px Barlow,sans-serif;color:#0878ac;letter-spacing:.06em}
  .lead-meta{font-size:12px;color:#677680;line-height:1.65}
  .lead-stage{display:grid;gap:6px}
  .lead-detail{border-top:1px solid #e3e8ea;padding:22px;display:grid;grid-template-columns:1fr 1fr;gap:26px}
  .lead-detail h3{font-size:16px;margin-bottom:10px}
  .lead-detail p{font-size:13px;margin:6px 0}
  .lead-actions{display:grid;gap:10px}
  .catalogue-links{display:grid;gap:6px}
  .catalogue-links a{color:#0878ac;font-size:12px;font-weight:600}
  .empty-admin{padding:40px;border:1px dashed #bbc7cc;text-align:center;background:#fff}
  @media(max-width:900px){
    .admin-login{grid-template-columns:1fr;gap:24px;padding:28px}
    .admin-metrics{grid-template-columns:repeat(2,1fr)}
    .admin-filters{grid-template-columns:1fr}
    .lead-summary{grid-template-columns:1fr}
    .lead-detail{grid-template-columns:1fr}
  }
</style>

<script>
  const loginPanel = document.getElementById('login-panel')!;
  const dashboard = document.getElementById('dashboard')!;
  const logout = document.getElementById('logout') as HTMLButtonElement;
  const list = document.getElementById('lead-list')!;
  const status = document.getElementById('dashboard-status')!;
  const search = document.getElementById('lead-search') as HTMLInputElement;
  const stageFilter = document.getElementById('stage-filter') as HTMLSelectElement;

  function esc(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;',
    }[c] || c));
  }

  function fmtDate(value: string) {
    try { return new Intl.DateTimeFormat('en-IN',{dateStyle:'medium',timeStyle:'short'}).format(new Date(value)); }
    catch { return value; }
  }

  function metric(label: string, value: number) {
    return '<div class="metric"><strong>' + value + '</strong><span>' + esc(label) + '</span></div>';
  }

  function render(leads: any[]) {
    const metrics = document.getElementById('metrics')!;
    metrics.innerHTML =
      metric('Total', leads.length) +
      metric('New', leads.filter((l) => l.stage === 'New').length) +
      metric('Quotation', leads.filter((l) => l.stage === 'Quotation').length) +
      metric('Follow-up', leads.filter((l) => l.stage === 'Follow-up').length) +
      metric('Won', leads.filter((l) => l.stage === 'Won').length);

    if (!leads.length) {
      list.innerHTML = '<div class="empty-admin">No enquiries match this view.</div>';
      return;
    }

    list.innerHTML = leads.map((lead) => {
      const catalogues = Array.isArray(lead.catalogues) ? lead.catalogues : [];
      const items = Array.isArray(lead.items) ? lead.items : [];
      const delivery = lead.delivery || {};
      const contact = [lead.phone, lead.email].filter(Boolean).join(' · ');
      return '<article class="lead-card" data-id="' + lead.id + '">' +
        '<div class="lead-summary">' +
          '<div><span class="lead-ref">' + esc(lead.reference) + '</span><div class="lead-meta">' + esc(fmtDate(lead.created_at)) + '</div></div>' +
          '<div><strong>' + esc(lead.name) + '</strong><div class="lead-meta">' + esc(lead.company || 'Individual enquiry') + '<br>' + esc(contact) + '</div></div>' +
          '<div><strong>' + esc(lead.category || lead.type || 'General requirement') + '</strong><div class="lead-meta">' + esc(lead.location || '') + (lead.brand ? ' · ' + esc(lead.brand) : '') + '</div></div>' +
          '<label class="lead-stage"><span class="mono">STAGE</span><select data-stage>' +
            ['New','Contacted','Qualified','Quotation','Follow-up','Won','Lost'].map((s) => '<option' + (lead.stage===s?' selected':'') + '>' + s + '</option>').join('') +
          '</select></label>' +
        '</div>' +
        '<div class="lead-detail">' +
          '<div>' +
            '<h3>Requirement</h3>' +
            '<p>' + esc(lead.details) + '</p>' +
            '<p><strong>Application:</strong> ' + esc(lead.usage_application || '-') + '</p>' +
            '<p><strong>Qty:</strong> ' + esc((lead.quantity || '-') + ' ' + (lead.quantity_unit || '')) + '</p>' +
            '<p><strong>Machine:</strong> ' + esc((lead.machine_type || '-') + ' ' + (lead.machine_model || '')) + '</p>' +
            (items.length ? '<p><strong>Selected:</strong> ' + items.map((i:any)=>esc(i.title)).join(' · ') + '</p>' : '') +
          '</div>' +
          '<div class="lead-actions">' +
            '<div><h3>Catalogue delivery</h3><div class="catalogue-links">' +
              catalogues.map((c:any)=>'<a href="' + esc(c.url) + '" target="_blank" rel="noopener">' + esc(c.title) + ' ↗</a>').join('') +
            '</div><p class="lead-meta">Email: ' + esc(delivery.customerEmail?.sent ? 'sent' : delivery.customerEmail?.attempted ? 'failed' : 'not configured') +
            ' · WhatsApp: ' + esc(delivery.whatsapp?.sent ? 'sent' : delivery.whatsapp?.attempted ? 'failed' : 'not configured') + '</p></div>' +
            '<label><span class="mono">INTERNAL NOTES</span><textarea rows="3" data-notes>' + esc(lead.notes || '') + '</textarea></label>' +
            '<button class="button button-primary" data-save>Save update</button>' +
          '</div>' +
        '</div>' +
      '</article>';
    }).join('');

    list.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((button) => {
      button.addEventListener('click', async () => {
        const card = button.closest<HTMLElement>('.lead-card')!;
        button.disabled = true;
        const response = await fetch('/api/admin/leads', {
          method:'PATCH',
          headers:{'content-type':'application/json'},
          body:JSON.stringify({
            id:Number(card.dataset.id),
            stage:(card.querySelector('[data-stage]') as HTMLSelectElement).value,
            notes:(card.querySelector('[data-notes]') as HTMLTextAreaElement).value,
          }),
        });
        button.disabled = false;
        status.textContent = response.ok ? 'Lead updated.' : 'Could not save this update.';
      });
    });
  }

  async function load() {
    status.textContent = 'Loading enquiries…';
    const params = new URLSearchParams();
    if (search.value.trim()) params.set('q', search.value.trim());
    if (stageFilter.value) params.set('stage', stageFilter.value);
    const response = await fetch('/api/admin/leads?' + params.toString(), {headers:{accept:'application/json'}});
    if (response.status === 401) {
      loginPanel.hidden = false;
      dashboard.hidden = true;
      logout.hidden = true;
      status.textContent = '';
      return;
    }
    const data = await response.json().catch(() => ({ok:false,error:'Unable to read server response.'}));
    if (!response.ok || !data.ok) {
      dashboard.hidden = false;
      loginPanel.hidden = true;
      logout.hidden = false;
      status.textContent = data.error || 'Unable to load enquiries.';
      return;
    }
    loginPanel.hidden = true;
    dashboard.hidden = false;
    logout.hidden = false;
    status.textContent = data.leads.length + ' enquiries loaded.';
    render(data.leads);
  }

  document.getElementById('login-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const error = document.getElementById('login-error')!;
    error.textContent = '';
    const response = await fetch('/api/admin/login', {
      method:'POST',
      headers:{'content-type':'application/json'},
      body:JSON.stringify({username:data.get('username'),password:data.get('password')}),
    });
    const result = await response.json().catch(() => ({ok:false,error:'Unable to sign in.'}));
    if (!response.ok || !result.ok) {
      error.textContent = result.error || 'Unable to sign in.';
      return;
    }
    form.reset();
    await load();
  });

  logout.addEventListener('click', async () => {
    await fetch('/api/admin/logout',{method:'POST'});
    await load();
  });

  document.getElementById('refresh')?.addEventListener('click', load);
  stageFilter.addEventListener('change', load);
  let timer:number;
  search.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(load, 300);
  });

  load();
</script>
