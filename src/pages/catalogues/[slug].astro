---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/global/Breadcrumb.astro';
import SpecTable from '../../components/products/SpecTable.astro';
import EnquiryButton from '../../components/enquiry/EnquiryButton.astro';
import Button from '../../components/global/Button.astro';
import { catalogues } from '../../data/catalogues';
import { products } from '../../data/products';

export function getStaticPaths() {
  return catalogues.map((catalogue) => ({
    params: { slug: catalogue.id },
    props: { catalogue },
  }));
}

const { catalogue } = Astro.props;
const product = products.find((item) => item.id === catalogue.productId);
---

<BaseLayout
  title={`${catalogue.brand} ${catalogue.title}`}
  description={catalogue.description}
  crumbs={[
    { name: 'Products', path: '/products/' },
    { name: product?.title || catalogue.title, path: product ? `/products/${product.id}/` : '/products/' },
    { name: 'Catalogue', path: `/catalogues/${catalogue.id}/` },
  ]}
>
  <section class="section paper catalogue-detail-page">
    <div class="container">
      <Breadcrumb
        items={[
          { title: 'Products', href: '/products/' },
          ...(product ? [{ title: product.title, href: `/products/${product.id}/` }] : []),
          { title: 'Catalogue' },
        ]}
      />

      <header class="catalogue-detail-hero">
        <div>
          <p class="eyebrow">{catalogue.eyebrow}</p>
          <p class="catalogue-brand">{catalogue.brand}</p>
          <h1 class="page-title">{catalogue.title}</h1>
          <p class="lead">{catalogue.description}</p>
          <div class="button-row">
            {product && (
              <EnquiryButton id={product.id} title={product.title} />
            )}
            {product && (
              <Button href={`/products/${product.id}/`} secondary>
                View product range
              </Button>
            )}
            {product && (
              <Button href={`/?category=${encodeURIComponent(product.title)}#requirement`}>
                Ask an Engineer
              </Button>
            )}
          </div>
        </div>
        <aside class="catalogue-verification-card">
          <p class="eyebrow">PRODUCT SELECTION</p>
          <h2>Confirm the application before ordering.</h2>
          <p>{catalogue.compatibility}</p>
        </aside>
      </header>

      <div class="catalogue-detail-grid">
        <section class="catalogue-detail-panel">
          <p class="eyebrow">KEY POINTS</p>
          <h2>Catalogue highlights</h2>
          <ul class="feature-list catalogue-feature-list">
            {catalogue.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="catalogue-detail-panel">
          <p class="eyebrow">APPLICATIONS</p>
          <h2>Where it is used</h2>
          <ul class="feature-list catalogue-feature-list">
            {catalogue.applications.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>

      {catalogue.table && (
        <section class="catalogue-spec-section">
          <p class="eyebrow">TECHNICAL DATA</p>
          <h2>Model comparison</h2>
          <SpecTable
            headers={catalogue.table.headers}
            rows={catalogue.table.rows}
            caption={catalogue.table.caption}
          />
          <p class="catalogue-note">
            Specifications and model availability should be confirmed with SHK for the current application.
          </p>
        </section>
      )}

      <section class="catalogue-contact-strip">
        <div>
          <p class="eyebrow">NEXT STEP</p>
          <h2>Send the machine details or application.</h2>
          <p>
            SHK can review the requirement, confirm compatibility and discuss the appropriate configuration.
          </p>
        </div>
        <div class="button-row">
          {product && <EnquiryButton id={product.id} title={product.title} />}
          <Button href={product ? `/?category=${encodeURIComponent(product.title)}#requirement` : '/#requirement'}>
            Share your requirement
          </Button>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
