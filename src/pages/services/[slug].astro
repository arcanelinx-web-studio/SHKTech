---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/global/Breadcrumb.astro';
import Button from '../../components/global/Button.astro';
import EnquiryButton from '../../components/enquiry/EnquiryButton.astro';
import { services } from '../../data/services';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}
const { service: s } = Astro.props;
const type =
  s.id.includes('calibration') || s.id.includes('ball-bar') || s.id.includes('alignment')
    ? 'Calibration'
    : s.id === 'retrofit'
      ? 'Retrofit'
      : 'Reconditioning';
---

<BaseLayout
  title={s.title}
  description={s.description}
  crumbs={[
    { name: 'Services', path: '/services/' },
    { name: s.title, path: `/services/${s.id}/` },
  ]}
>
  <section class="section paper">
    <div class="container">
      <Breadcrumb items={[{ title: 'Services', href: '/services/' }, { title: s.title }]} />
      <p class="eyebrow">MACHINE SERVICES</p>
      <h1 class="page-title">{s.title}</h1>
      <p class="lead">{s.description}</p>
      <div class="button-row">
        <Button
          href={`/?type=${type}&details=${encodeURIComponent('I would like to discuss ' + s.title + '.')}#requirement`}
        >
          Discuss your machine
        </Button>
        <EnquiryButton id={s.id} title={s.title} kind="service" />
      </div>
      <div class="detail-columns">
        <div>
          <h2>The problem</h2>
          <p class="lead">{s.problem}</p>
          <h2>What SHK provides</h2>
          <ul class="feature-list">
            {s.provides.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
          <h2>Machines & applications</h2>
          <ul class="feature-list">
            {s.applications.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
        <aside class="detail-aside">
          <p class="eyebrow">A PRACTICAL STARTING POINT</p>
          <h2>Agree the scope.</h2>
          <ol class="process-list">
            {s.process.map((p) => (
              <li>{p}</li>
            ))}
          </ol>
          <p>
            The work and verification plan are agreed after reviewing the machine. Share symptoms,
            control details and any existing measurements.
          </p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
