---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/global/Breadcrumb.astro';
import EnquiryButton from '../../components/enquiry/EnquiryButton.astro';
import { services } from '../../data/services';
---

<BaseLayout title="CNC machine services" crumbs={[{ name: 'Services', path: '/services/' }]}>
  <section class="section paper service-index-page">
    <div class="container">
      <Breadcrumb items={[{ title: 'Services' }]} />
      <div class="catalogue-intro">
        <div>
          <p class="eyebrow">MACHINE PERFORMANCE / LIFECYCLE</p>
          <h1 class="page-title">Understand the error. Define the next step.</h1>
        </div>
        <p class="lead">
          Calibration, alignment, reconditioning and subsystem retrofit. Begin with your machine and
          the problem you are seeing.
        </p>
      </div>

      <div class="service-index">
        {services.map((s, i) => (
          <article class="service-row">
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2><a href={`/services/${s.id}/`}>{s.title}</a></h2>
              <p>{s.description}</p>
            </div>
            <div class="service-row-actions">
              <EnquiryButton id={s.id} title={s.title} kind="service" />
              <a class="text-link" href={`/services/${s.id}/`}>Explore service ↗</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
