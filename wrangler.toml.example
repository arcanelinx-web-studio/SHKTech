name = "shk-tech-services"
pages_build_output_dir = "./dist"

# Copy this file to wrangler.toml only after creating the D1 database.
# Keep database IDs and secrets out of source control.

[[d1_databases]]
binding = "DB"
database_name = "shk-enquiries"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
